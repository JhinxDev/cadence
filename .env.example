# Navidrome URL reachable from the Cadence Companion container
NAVIDROME_URL=http://navidrome:4533

# Generate a strong random secret: openssl rand -hex 32
CADENCE_SECRET_KEY=replace-with-a-64-char-random-hex-secret

# Discovery audio provider:
#   preview -> clean 30s catalog previews from open APIs (public safe default)
#   command -> external resolver script configured via CADENCE_PROVIDER_SCRIPT
CADENCE_PROVIDER=preview
CADENCE_PROVIDER_SCRIPT=

# Storage paths inside container
CADENCE_DATA_DIR=/data
CADENCE_MUSIC_DIR=/music
CADENCE_CACHE_MAX_MB=2048
CADENCE_SYNC_PLAYLISTS=true
